{
  "manifest_version": 3,
  "name": "Organizer — Tabs & Bookmarks",
  "version": "0.1.0",
  "description": "Back up, restore, import, export, and organize tabs and bookmarks.",
  "permissions": ["tabs", "bookmarks", "storage"],
  "host_permissions": ["https://davefrassoni.com/*", "https://api.openai.com/*", "https://api.anthropic.com/*", "https://generativelanguage.googleapis.com/*"],
  "background": {"scripts": ["background.js"]},
  "action": {"default_popup": "popup/popup.html", "default_title": "Organizer"},
  "options_ui": {"page": "options/options.html", "open_in_tab": true},
  "browser_specific_settings": {"gecko": {"id": "organizer@davefrassoni.com", "strict_min_version": "109.0"}},
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}
}
